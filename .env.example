# Server Configuration
NODE_ENV=development
PORT=5000
CORS_ORIGIN=*

# JWT Configuration (Change these to strong random secrets in production!)
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Firebase Configuration
# Option 1: Path to your Firebase service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option 2: Paste the entire service account JSON on a single line (useful for cloud hosting)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Option 3: Set Firebase Project ID (works with Application Default Credentials or Emulator)
FIREBASE_PROJECT_ID=your-firebase-project-id
# Optional: Specify named Firestore database (defaults to "(default)")
# FIRESTORE_DATABASE_ID=(default)

# Option 4: Local Firebase Emulator (uncomment to use Firestore Emulator)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Optional: Admin bootstrap secret for creating the very first admin via /api/auth/register-admin
ADMIN_BOOTSTRAP_SECRET=replace_with_admin_bootstrap_secret
